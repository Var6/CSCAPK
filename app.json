{
  "expo": {
    "name": "CSC Travel",
    "slug": "csctravel",
    "scheme": "csctravel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csctravels.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to set the pickup point for your rides."
      }
    },
    "android": {
      "package": "com.csctravels.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CSC Travel to use your location to set ride pickup points."
        }
      ]
    ],
    "extra": {
      "SUPABASE_URL": "",
      "SUPABASE_ANON_KEY": ""
    }
  }
}
