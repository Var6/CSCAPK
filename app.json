{
  "expo": {
    "name": "CSC Travel",
    "slug": "csctravels",
    "scheme": "csctravel",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f97316"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.csctravels.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to set the pickup point for your rides."
      }
    },
    "android": {
      "package": "com.csctravels.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CSC Travel to use your location to set ride pickup points."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e28eb360-ee1b-478e-9c7d-302fbc98531f"
      }
    },
    "owner": "rishabh_stark"
  }
}
